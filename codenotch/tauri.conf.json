{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codenotch",
  "version": "0.10.0",
  "identifier": "com.immidi.codenotch",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Codenotch settings",
        "url": "settings.html",
        "width": 640,
        "height": 720,
        "minWidth": 460,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
